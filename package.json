{
  "name": "aibiz-workspace-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local verification and orchestration tools for the aibiz workspace",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser-contracts": "node --test tests/native-login-reload.browser.mjs tests/native-global-util.browser.mjs tests/native-studio-theme.browser.mjs",
    "test:external-ui": "node external-ui-harness.mjs --required",
    "test:native-platform-api": "node harness-native-platform-api.mjs --required",
    "test:native-modeldesign": "node ../modelingweb/app/tests/native-modeldesign.browser.mjs",
    "compose:native-candidate": "node native-candidate-compose.mjs",
    "test:native-resources": "node --test tests/repair-native-model-resources.test.mjs",
    "test:plm-backend-source": "node --test tests/plm-backend-source.test.mjs tests/plm-ibiz-dependency-closure.test.mjs",
    "test:plm-backend-runtime-regression": "node harness-plm-backend-runtime-regression.mjs",
    "test:native-model-design-inputs": "node --test tests/native-model-design-inputs.test.mjs",
    "test:native-ai-code-deployment": "node --test tests/native-ai-code-deployment.test.mjs",
    "test:native-ai-code-docker": "node --test tests/native-ai-code-docker*.test.mjs",
    "test:native-ai-code-runtime": "node harness-native-ai-code-runtime.mjs",
    "prepare:native-ai-code-runtime": "node prepare-native-ai-code-runtime-assets.mjs",
    "test:native-ai-code-source-deps": "node --test tests/native-ai-code-source-deps.test.mjs tests/native-ai-code-source-deployment.test.mjs",
    "build:native-ai-code-source-deps": "node harness-native-ai-code-source-deps.mjs",
    "fetch:native-cli-source": "node fetch-native-cli-source.mjs",
    "build:native-cli-source": "node harness-native-cli-source-build.mjs",
    "test:native-cli-source": "node --test tests/fetch-native-cli-source.test.mjs tests/native-cli-source-build.test.mjs tests/native-cli-build-options.test.mjs tests/native-cli-toolchain.test.mjs",
    "harness:ui": "node harness-ui-server.mjs",
    "test:project": "npm test && npm run test:browser-contracts && npm run ledger && npm run test:external-ui && npm run test:modeling-runtime",
    "test:ci": "npm test && npm run test:browser-contracts && npm run ledger && npm run test:modeling-runtime:required && npm run test:external-ui && npm run test:native-platform-api && npm run test:native-modeldesign",
    "test:modeling-runtime": "node harness-modeling-runtime.mjs --mode auto",
    "test:modeling-runtime:required": "node harness-modeling-runtime.mjs --required",
    "test:baseline": "bash harness-baseline.sh",
    "ledger": "node version-ledger.mjs",
    "ledger:live": "node version-ledger.mjs --live",
    "localize": "node localize-base-packages.mjs",
    "localize:apply": "node localize-base-packages.mjs --apply"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pnpm": "^12.5.1"
  }
}
